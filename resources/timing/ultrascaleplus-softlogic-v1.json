      "clock": "C",
      "data": "D",
      "output": "Q",
      "controls": ["CE", "S"],
      "control_checks": {
        "CE": {"kind": "setup", "margin_ns": 0.08},
        "S": {"kind": "setup", "margin_ns": 0.08}
