      "controls": ["CE", "CLR"],
      "control_checks": {
        "CE": {"kind": "setup", "margin_ns": 0.08},
        "CLR": {"kind": "recovery", "margin_ns": 0.08}
      },
      "setup_ns": 0.08,
      "clock_to_q_ns": 0.12
    },
    "FDPE": {
      "kind": "rising_edge_ff",
      "clock": "C",
      "data": "D",
      "output": "Q",
      "controls": ["CE", "PRE"],
      "control_checks": {
        "CE": {"kind": "setup", "margin_ns": 0.08},
        "PRE": {"kind": "recovery", "margin_ns": 0.08}
      },
      "setup_ns": 0.08,
      "clock_to_q_ns": 0.12
    },
    "FDRE": {
      "kind": "rising_edge_ff",
      "clock": "C",
      "data": "D",
      "output": "Q",
      "controls": ["CE", "R"],
      "control_checks": {
        "CE": {"kind": "setup", "margin_ns": 0.08},
        "R": {"kind": "setup", "margin_ns": 0.08}
