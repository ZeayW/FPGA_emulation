{
  "schema": "emuflow.fpga-timing-model/v1",
  "name": "ultrascaleplus-softlogic-analytical-v1",
  "family": "xcup",
  "source": {
    "provider": "emuflow-analytical-model",
    "qualification": "analytical_uncharacterized",
    "description": "Open, deterministic bring-up model for OpenSTA integration. Values are not device characterization and must be calibrated before timing sign-off.",
    "control_checks": "Uncharacterized setup/recovery planning margins; recovery checks both input transitions. Hold/removal sign-off requires implemented device timing."
  },
  "cells": {
