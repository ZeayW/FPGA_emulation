        "scripts/rapidwright/EmuFlowRouteResourceCertificate.java",
        "scripts/rapidwright/export_route_resource_certificate.py"
      ],
      "build_targets": [
        "emuflow_fpgaif_arch_importer",
        "emuflow_python"
      ],
      "runtime_products": [
        "emuflow_fpgaif_arch_importer",
        "emuflow"
      ],
      "integration": "default-in-tree-build"
    },
