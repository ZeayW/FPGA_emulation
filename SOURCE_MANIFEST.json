      "source_paths": [
        "engines/cudd"
      ],
      "build_targets": [
        "cudd_native"
      ],
      "runtime_products": [
        "libcudd"
      ],
      "integration": "default-in-tree-build"
    },
    {
      "id": "open-fpga-architecture-import",
      "stage": "R0 / Phase 2 architecture database",
