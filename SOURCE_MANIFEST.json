{
  "schema": "emuflow.source-manifest/v1",
  "policy": {
    "implementation_boundary": "Every default flow engine is editable source in this repository and is built from the repository root.",
    "runtime_boundary": "Compiled executables and extension modules are local build products, never published implementations.",
    "external_tools": "Proprietary tools may be optional timing, implementation, comparison, or sign-off providers, but may not satisfy an open-flow completion gate."
  },
  "components": [
    {
