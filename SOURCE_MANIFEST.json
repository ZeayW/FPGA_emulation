  ],
  "open_path_blockers": [
    {
      "id": "open-ultrascale-plus-bitstream",
      "status": "out-of-scope-until-viable",
      "reason": "Vivado bitstream generation is optional proprietary sign-off and cannot count as completion of the source-complete path."
    }
  ],
  "optional_external_validation": [
    {
      "tool": "RapidWright standalone distribution",
      "uses": [
        "exact XCVU19P DeviceResources generation",
        "physical-region sidecar generation",
        "RWRoute physical routing",
        "architecture and route comparison"
      ],
      "counts_as_open_flow_implementation": false
    },
    {
      "tool": "Vivado",
      "uses": [
        "architecture comparison",
        "common TimingPathDB production",
        "GT Wizard product generation from the in-tree editable Tcl recipe",
        "per-FPGA synthesis, placement, routing, and timing",
        "board-integrated routed logic and interface timing feedback",
        "route and DRC comparison",
        "bitstream generation"
      ],
      "counts_as_open_flow_implementation": false
    }
  ]
}
