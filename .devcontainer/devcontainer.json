{
  "name": "EmuFlow partition development",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },
  "postCreateCommand": "bash scripts/codespaces/bootstrap.sh",
  "remoteEnv": {
    "EMUFLOW_NATIVE_ROOT": "${containerWorkspaceFolder}/build/codespaces-core/install",
    "PATH": "${containerWorkspaceFolder}/.venv/bin:${containerWorkspaceFolder}/build/codespaces-core/install/bin:${containerEnv:PATH}",
    "PYTHONPATH": "${containerWorkspaceFolder}/src:${containerWorkspaceFolder}"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-vscode.cmake-tools",
        "ms-vscode.cpptools",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
        "cmake.configureOnOpen": false,
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
