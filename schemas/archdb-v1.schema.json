{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emuflow.dev/schemas/archdb-v1.schema.json",
  "title": "EmuFlow ArchitectureDB v1",
  "type": "object",
  "required": ["schema", "part", "source", "policy", "sites"],
  "properties": {
    "schema": {"const": "emuflow.archdb/v1"},
    "part": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "required": ["format"],
      "properties": {
        "format": {"type": "string", "minLength": 1},
        "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "generator": {"type": "string"},
        "generator_qualification": {"type": "string"}
      }
    },
    "policy": {"type": "object"},
    "coordinate_transform": {"type": "object"},
    "physical_region_model": {
      "type": "object",
      "properties": {
        "slr_encoded": {"type": "boolean"},
        "clock_region_encoded": {"type": "boolean"},
        "io_bank_encoded": {"type": "boolean"},
        "qualification": {"type": "string"},
        "overlay": {"type": "object"}
      }
    },
    "physical_regions": {
      "type": "object",
      "properties": {
        "slrs": {"type": "array"},
        "clock_regions": {"type": "array"},
        "io_banks": {"type": "array"}
      }
    },
    "packages": {"type": "array"},
    "routing_resource_counts": {"type": "object"},
    "routing_reference_integrity": {
      "type": "object",
      "required": [
        "status",
        "site_types",
        "tile_types",
        "tiles",
        "wires",
        "nodes",
        "pips"
      ],
      "properties": {
        "status": {"const": "pass"},
        "site_types": {"type": "integer", "minimum": 0},
        "tile_types": {"type": "integer", "minimum": 0},
        "tiles": {"type": "integer", "minimum": 0},
        "wires": {"type": "integer", "minimum": 0},
        "nodes": {"type": "integer", "minimum": 0},
        "pips": {"type": "integer", "minimum": 0}
      }
    },
    "site_templates": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["bels"],
        "properties": {
          "alternative_templates": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "bels": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    "sites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "type", "x", "y"],
        "oneOf": [
          {"required": ["bels"]},
          {"required": ["template"]}
        ],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "type": {"type": "string", "minLength": 1},
          "x": {"type": "integer", "minimum": 0},
          "y": {"type": "integer", "minimum": 0},
          "tile": {"type": "object"},
          "physical_region": {"type": "object"},
          "template": {"type": "string", "minLength": 1},
          "bels": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name", "type", "z", "compatible_cells"],
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "type": {"type": "string", "minLength": 1},
                "z": {"type": "integer", "minimum": 0},
                "compatible_cells": {
                  "type": "array",
                  "minItems": 1,
                  "items": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        }
      }
    }
  }
}
