{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emuflow.dev/schemas/rapidwright-route-resource-certificate-v1.schema.json",
  "title": "EmuFlow RapidWright native routing-resource certificate v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "payload", "payload_sha256"],
  "properties": {
    "schema": {
      "const": "emuflow.rapidwright-route-resource-certificate/v1"
    },
    "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device",
        "device_database_md5",
        "full_part",
        "generator",
        "provider_manifest_sha256",
        "reference_integrity",
        "resource_counts",
        "route_backend",
        "timing_qualification"
      ],
      "properties": {
        "device": {"type": "string", "minLength": 1},
        "device_database_md5": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "full_part": {"type": "string", "minLength": 1},
        "generator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["revision", "version"],
          "properties": {
            "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "version": {"type": "string", "minLength": 1}
          }
        },
        "provider_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "reference_integrity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["errors", "route_resources_present", "status"],
          "properties": {
            "errors": {"const": 0},
            "route_resources_present": {"const": true},
            "status": {"const": "pass"}
          }
        },
        "resource_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "all_sites",
            "all_tiles",
            "node_wire_memberships",
            "nodes",
            "pips",
            "site_types",
            "tile_types",
            "wires",
            "wires_unaccounted",
            "wires_without_node"
          ],
          "properties": {
            "all_sites": {"type": "integer", "minimum": 1},
            "all_tiles": {"type": "integer", "minimum": 1},
            "node_wire_memberships": {"type": "integer", "minimum": 1},
            "nodes": {"type": "integer", "minimum": 1},
            "pips": {"type": "integer", "minimum": 1},
            "site_types": {"type": "integer", "minimum": 1},
            "tile_types": {"type": "integer", "minimum": 1},
            "wires": {"type": "integer", "minimum": 1},
            "wires_unaccounted": {"type": "integer", "minimum": 0},
            "wires_without_node": {"type": "integer", "minimum": 0}
          }
        },
        "route_backend": {"const": "rapidwright-native-device-database-v1"},
        "timing_qualification": {
          "const": "not-encoded-rwroute-native-device-database"
        }
      }
    }
  }
}
