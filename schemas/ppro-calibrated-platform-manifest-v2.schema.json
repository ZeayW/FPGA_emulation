{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emuflow.dev/schema/ppro-calibrated-platform-manifest-v2.schema.json",
  "title": "EmuFlow PPro-calibrated academic platform manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "configuration_id", "claim_scope", "physical_contract", "not_claimed", "fabric_clock_provenance", "fabric_clock_mhz", "parameter_provenance", "capacity_projection", "source_hashes", "profiles"],
  "properties": {
    "schema": {"const": "emuflow.ppro-calibrated-platform-manifest/v2"},
    "configuration_id": {"type": "string", "minLength": 1},
    "claim_scope": {"const": "PPro-behavior-equivalent-academic-model"},
    "physical_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frontend_mapping_profile", "physical_backend", "physical_placer", "provider_id", "provider_revision", "part"],
      "properties": {
        "frontend_mapping_profile": {"const": "xilinx-ultrascaleplus-open-v1"},
        "physical_backend": {"const": "rapidwright"},
        "physical_placer": {"const": "openparf-native"},
        "provider_id": {"const": "rapidwright-xilinx-device-v1"},
        "provider_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "part": {"type": "string", "minLength": 1}
      }
    },
    "not_claimed": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "fabric_clock_provenance": {"const": "research_assumption"},
    "fabric_clock_mhz": {"$ref": "#/$defs/profiles"},
    "parameter_provenance": {"type": "object", "minProperties": 1},
    "capacity_projection": {"type": "object"},
    "source_hashes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aggressive", "nominal", "conservative"],
      "properties": {
        "aggressive": {"$ref": "#/$defs/artifactHashes"},
        "nominal": {"$ref": "#/$defs/artifactHashes"},
        "conservative": {"$ref": "#/$defs/artifactHashes"}
      }
    }
  },
  "$defs": {
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aggressive", "nominal", "conservative"],
      "properties": {
        "aggressive": {"type": "number", "exclusiveMinimum": 0},
        "nominal": {"type": "number", "exclusiveMinimum": 0},
        "conservative": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "artifactHashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boarddb", "board_link_timing", "transport_cost"],
      "properties": {
        "boarddb": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "board_link_timing": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "transport_cost": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
