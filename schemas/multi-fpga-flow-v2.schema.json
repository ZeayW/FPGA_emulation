{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emuflow.dev/schema/multi-fpga-flow-v2.schema.json",
  "title": "EmuFlow provider-neutral multi-FPGA flow report v2",
  "type": "object",
  "required": [
    "schema",
    "status",
    "provider",
    "architecture_policy",
    "runtime",
    "stages",
    "artifacts",
    "summary"
  ],
  "properties": {
    "schema": {
      "const": "emuflow.multi-fpga-flow/v2"
    },
    "status": {
      "const": "pass"
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "architecture_policy": {
      "const": "provider-neutral"
    },
    "runtime": {
      "type": "object"
    },
    "physical": {
      "type": "object"
    },
    "board_link_timing": {
      "type": "object",
      "properties": {
        "status": {
          "const": "pass"
        },
        "validation": {
          "type": "object"
        },
        "routing_projection": {
          "type": "object"
        },
        "applied_to": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "status",
        "validation",
        "routing_projection",
        "applied_to"
      ]
    },
    "stages": {
      "type": "object",
      "required": [
        "frontend",
        "partition",
        "system_route",
        "tdm",
        "split"
      ]
    },
    "artifacts": {
      "type": "object"
    },
    "summary": {
      "type": "object",
      "required": [
        "status",
        "design",
        "platform",
        "physical_status"
      ]
    }
  },
  "additionalProperties": true
}
