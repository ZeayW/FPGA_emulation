{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emuflow.dev/schema/boarddb-v1.schema.json",
  "title": "EmuFlow virtual/hardware BoardDB v1",
  "type": "object",
  "required": [
    "schema",
    "platform",
    "fpgas",
    "links"
  ],
  "properties": {
    "schema": {
      "const": "emuflow.boarddb/v1"
    },
    "platform": {
      "type": "object",
      "required": [
        "name",
        "kind"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "virtual",
            "hardware"
          ]
        }
      }
    },
    "fpgas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "part",
          "capacity",
          "utilization_limit"
        ],
        "properties": {
          "hp_io_bank_count": {
            "type": "integer",
            "minimum": 0
          },
          "hd_io_bank_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "capacity_sharing": {
            "enum": [
              "per_direction",
              "shared_bidirectional"
            ]
          },
          "payload_bits_per_lane_per_cycle": {
            "type": "integer",
            "minimum": 1
          },
          "max_line_rate_gbps_per_lane": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "endpoint_bindings": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "object",
              "required": [
                "fpga",
                "connector",
                "mgt",
                "lanes"
              ],
              "properties": {
                "fpga": {
                  "type": "string",
                  "minLength": 1
                },
                "connector": {
                  "type": "string",
                  "minLength": 1
                },
                "mgt": {
                  "type": "string",
                  "minLength": 1
                },
                "lanes": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": [
                      "lane",
                      "tx_package_pins",
                      "rx_package_pins"
                    ],
                    "properties": {
                      "lane": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "tx_package_pins": {
                        "$ref": "#/$defs/differentialPins"
                      },
                      "rx_package_pins": {
                        "$ref": "#/$defs/differentialPins"
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "bank_count": {
            "type": "integer",
            "minimum": 1,
            "description": "Total corresponding single-direction bank groups shared by both directions; counts HP banks at each endpoint, not the sum of both endpoints."
          },
          "wires_per_bank": {
            "type": "integer",
            "minimum": 1,
            "description": "Effective data wires per bank, after reserved pins/signals; not the device pin inventory."
          },
          "tdm_delay_model": {
            "type": "object",
            "required": [
              "model",
              "intercept_ns",
              "ratio_coefficient_ns"
            ],
            "properties": {
              "model": {
                "const": "linear-ratio-v1"
              },
              "intercept_ns": {
                "type": "number",
                "minimum": 0
              },
              "ratio_coefficient_ns": {
                "type": "number",
                "minimum": 0
              }
            },
            "additionalProperties": false
          },
          "cable_count": {
            "type": "integer",
            "minimum": 1
          },
          "hp_banks_per_cable": {
            "type": "integer",
            "minimum": 1,
            "description": "HP I/O banks occupied at EACH endpoint of a cable; each bank has one direction, independently of other banks in the cable."
          }
        },
        "required": [
          "id",
          "endpoints",
          "direction",
          "mode",
          "data_lanes_per_direction",
          "fabric_clock_mhz",
          "latency_cycles"
        ],
        "dependentRequired": {
          "bank_count": [
            "wires_per_bank"
          ],
          "wires_per_bank": [
            "bank_count"
          ],
          "cable_count": [
            "hp_banks_per_cable",
            "bank_count",
            "wires_per_bank"
          ],
          "hp_banks_per_cable": [
            "cable_count",
            "bank_count",
            "wires_per_bank"
          ]
        }
      }
    },
    "board_services": {
      "type": "object",
      "properties": {
        "clocks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "signal",
              "kind",
              "frequency_mhz",
              "frequency_qualification",
              "count",
              "destination",
              "binding_status",
              "qualification"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "signal": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "frequency_mhz": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "frequency_qualification": {
                "enum": [
                  "fixed",
                  "documented_default",
                  "configured"
                ]
              },
              "count": {
                "type": "integer",
                "minimum": 1
              },
              "destination": {
                "type": "string",
                "minLength": 1
              },
              "binding_status": {
                "enum": [
                  "logical_source_without_package_pins",
                  "package_bound"
                ]
              },
              "qualification": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "resets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "signal",
              "polarity",
              "purpose",
              "binding_status",
              "qualification"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "signal": {
                "type": "string",
                "minLength": 1
              },
              "polarity": {
                "enum": [
                  "active_low",
                  "active_high"
                ]
              },
              "purpose": {
                "type": "string",
                "minLength": 1
              },
              "binding_status": {
                "enum": [
                  "logical_source_without_package_pins",
                  "package_bound"
                ]
              },
              "qualification": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "differentialPins": {
      "type": "object",
      "required": [
        "p",
        "n"
      ],
      "properties": {
        "p": {
          "type": "string",
          "minLength": 1
        },
        "n": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
