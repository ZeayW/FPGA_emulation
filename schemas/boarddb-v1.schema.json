{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emuflow.dev/schema/boarddb-v1.schema.json",
  "title": "EmuFlow virtual/hardware BoardDB v1",
  "type": "object",
  "required": ["schema", "platform", "fpgas", "links"],
  "properties": {
    "schema": {"const": "emuflow.boarddb/v1"},
    "platform": {
      "type": "object",
      "required": ["name", "kind"],
      "properties": {
        "name": {"type": "string"},
        "kind": {"enum": ["virtual", "hardware"]},
        "capacity_contract": {
          "type": "object",
          "required": ["capacity_field_semantics", "academic_capacity_axis", "reference_capacity_axis", "reference_target_granularity", "physical_device_identity", "physical_capacity_source", "physical_resource_capacity", "reference_flow_capacity_per_fpga"],
          "properties": {
            "capacity_field_semantics": {"const": "academic_mapper_equivalent_capacity_per_fpga"},
            "academic_capacity_axis": {"const": "academic_mapper_equivalent"},
            "reference_capacity_axis": {"const": "reference_flow_reported"},
            "reference_target_granularity": {"const": "single_physical_fpga"},
            "physical_device_identity": {"type": "string", "minLength": 1},
            "physical_capacity_source": {"type": "string", "minLength": 1},
            "physical_resource_capacity": {"type": "object", "minProperties": 1},
            "reference_flow_capacity_per_fpga": {"type": "object", "minProperties": 1}
          },
          "additionalProperties": false
        }
      }
    },
    "fpgas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "part", "capacity", "utilization_limit"]
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "capacity_sharing": {
            "enum": ["per_direction", "shared_bidirectional"]
          },
          "payload_bits_per_lane_per_cycle": {
            "type": "integer",
            "minimum": 1
          },
          "max_line_rate_gbps_per_lane": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "endpoint_bindings": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "object",
              "required": ["fpga", "connector", "mgt", "lanes"],
              "properties": {
                "fpga": {"type": "string", "minLength": 1},
                "connector": {"type": "string", "minLength": 1},
                "mgt": {"type": "string", "minLength": 1},
                "lanes": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": [
                      "lane",
                      "tx_package_pins",
                      "rx_package_pins"
                    ],
                    "properties": {
                      "lane": {"type": "integer", "minimum": 0},
                      "tx_package_pins": {"$ref": "#/$defs/differentialPins"},
                      "rx_package_pins": {"$ref": "#/$defs/differentialPins"}
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "endpoints",
          "direction",
          "mode",
          "data_lanes_per_direction",
          "fabric_clock_mhz",
          "latency_cycles"
        ]
      }
    },
    "board_services": {
      "type": "object",
      "properties": {
        "clocks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "signal", "kind", "frequency_mhz", "frequency_qualification", "count", "destination", "binding_status", "qualification"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "signal": {"type": "string", "minLength": 1},
              "kind": {"type": "string", "minLength": 1},
              "frequency_mhz": {"type": "number", "exclusiveMinimum": 0},
              "frequency_qualification": {"enum": ["fixed", "documented_default", "configured"]},
              "count": {"type": "integer", "minimum": 1},
              "destination": {"type": "string", "minLength": 1},
              "binding_status": {"enum": ["logical_source_without_package_pins", "package_bound"]},
              "qualification": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "resets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "signal", "polarity", "purpose", "binding_status", "qualification"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "signal": {"type": "string", "minLength": 1},
              "polarity": {"enum": ["active_low", "active_high"]},
              "purpose": {"type": "string", "minLength": 1},
              "binding_status": {"enum": ["logical_source_without_package_pins", "package_bound"]},
              "qualification": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "differentialPins": {
      "type": "object",
      "required": ["p", "n"],
      "properties": {
        "p": {"type": "string", "minLength": 1},
        "n": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
