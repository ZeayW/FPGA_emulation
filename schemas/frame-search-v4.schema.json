{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emuflow.dev/schemas/frame-search-v4.schema.json",
  "title": "EmuFlow checked minimum-frame search with selectable TDM provider",
  "type": "object",
  "required": [
    "schema", "status", "provider", "objective", "maximum_frame_slots",
    "selected_frame_slots", "speedup_over_maximum", "evaluated_candidates",
    "configuration", "attempts", "selected_candidate"
  ],
  "properties": {
    "schema": {"const": "emuflow.frame-search/v4"},
    "status": {"const": "pass"},
    "provider": {"const": "checked-monotone-bisection-v1"},
    "objective": {"const": "minimum-feasible-frame-slots"},
    "maximum_frame_slots": {"type": "integer", "minimum": 2},
    "selected_frame_slots": {"type": "integer", "minimum": 2},
    "speedup_over_maximum": {"type": "number", "minimum": 1},
    "evaluated_candidates": {"type": "integer", "minimum": 1},
    "configuration": {
      "type": "object",
      "required": [
        "ratio_max_iterations", "max_ratio", "ratio_quantum",
        "post_refinement_iterations", "slot_refinement_iterations",
        "tdm_provider", "ratio_convergence", "simulation_frames"
      ],
      "properties": {
        "ratio_max_iterations": {"type": "integer", "minimum": 1},
        "max_ratio": {"type": ["integer", "null"], "minimum": 1},
        "ratio_quantum": {"type": "integer", "minimum": 1},
        "post_refinement_iterations": {"type": "integer", "minimum": 0},
        "slot_refinement_iterations": {"type": "integer", "minimum": 0},
        "tdm_provider": {"type": ["string", "null"]},
        "route_provider": {"const": "synergistic-author-route-v1"},
        "author_cost_policy": {"enum": ["author-pressure-v1", "author-sll-pressure-v1", "best-of-two-v1"]},
        "ratio_convergence": {"type": "number", "exclusiveMinimum": 0},
        "simulation_frames": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false,
      "dependentRequired": {
        "route_provider": ["author_cost_policy"],
        "author_cost_policy": ["route_provider"]
      }
    },
    "attempts": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "selected_candidate": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
