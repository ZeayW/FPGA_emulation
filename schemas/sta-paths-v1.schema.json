{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ZeayW/FGPA_emulation/schemas/sta-paths-v1.schema.json",
  "title": "EmuFlow STA timing paths v1",
  "type": "object",
  "required": ["schema", "design", "paths"],
  "properties": {
    "schema": {"const": "emuflow.sta-paths/v1"},
    "design": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "required": ["provider"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "input": {"type": "string", "minLength": 1},
        "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "anyOf": [{"required": ["input"]}, {"required": ["input_sha256"]}],
      "additionalProperties": false
    },
    "output_realizations": {"$ref": "https://emuflow.dev/schemas/output-realizations-v1.schema.json"},
    "normalization": {
      "type": "object",
      "required": ["positive_slack_scale_ns", "negative_slack_scale_ns", "max_clock_period_ns"],
      "properties": {
        "positive_slack_scale_ns": {"type": "number", "exclusiveMinimum": 0},
        "negative_slack_scale_ns": {"type": "number", "exclusiveMinimum": 0},
        "max_clock_period_ns": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": false
    },
    "compression": {
      "type": "object",
      "required": ["original_paths", "compressed_paths", "lossless_by"],
      "properties": {
        "original_paths": {"type": "integer", "minimum": 1},
        "compressed_paths": {"type": "integer", "minimum": 1},
        "realized_paths": {"type": "integer", "minimum": 1},
        "member_constraints": {"const": "fixed-delay-shared-required/v1"},
        "lossless_by": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "clock_domain",
          "clock_period_ns",
          "slack_ns",
          "fixed_delay_ns",
          "cut_nets"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "clock_domain": {"type": "string", "minLength": 1},
          "clock_period_ns": {"type": "number", "exclusiveMinimum": 0},
          "slack_ns": {"type": "number"},
          "fixed_delay_ns": {"type": "number", "minimum": 0},
          "required_time_ns": {"type": "number"},
          "member_fixed_delay_ns": {
            "type": "array", "minItems": 1,
            "items": {"type": "number", "minimum": 0}
          },
          "cut_nets": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "normalized_slack": {"type": "number"},
          "compressed_path_ids": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "cut_transitions": {
            "type": "array",
            "items": {
              "type": "object", "required": ["net", "from", "to"],
              "properties": {
                "net": {"type": "string", "minLength": 1},
                "from": {"type": "string", "minLength": 1},
                "to": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          },
          "cut_signature": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["compression"],
        "properties": {"compression": {"required": ["member_constraints"]}}
      },
      "then": {
        "properties": {"paths": {"items": {
          "required": ["compressed_path_ids", "member_fixed_delay_ns", "required_time_ns"]
        }}}
      }
    },
    {
      "if": {"properties": {"paths": {"contains": {"required": ["member_fixed_delay_ns"]}}}},
      "then": {
        "required": ["compression"],
        "properties": {"compression": {"required": ["member_constraints"]}}
      }
    }
  ],
  "additionalProperties": false
}
