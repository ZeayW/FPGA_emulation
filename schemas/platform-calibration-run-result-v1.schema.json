{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emuflow.dev/schema/platform-calibration-run-result-v1.schema.json",
  "title": "EmuFlow aggregate reference-flow calibration run result v1",
  "type": "object",
  "required": ["schema", "case_id", "status", "controls", "metrics"],
  "properties": {
    "schema": {"const": "emuflow.platform-calibration-run-result/v1"},
    "case_id": {"type": "string", "minLength": 1},
    "status": {
      "enum": ["pass", "capacity_fail", "link_capacity_fail", "provider_fail", "license_fail", "transport_fail", "execution_fail"]
    },
    "controls": {
      "type": "object",
      "required": ["assignment_applied", "route_applied", "observed_assignment", "observed_route"],
      "properties": {
        "assignment_applied": {"type": "boolean"},
        "route_applied": {"type": "boolean"},
        "observed_assignment": {
          "type": "object",
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "observed_route": {
          "type": ["array", "null"],
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "properties": {
        "actual_resource_demand_per_fpga": {"type": "integer", "minimum": 1},
        "sr0_worst_cross_fpga_delay_ns": {"type": "number", "exclusiveMinimum": 0},
        "sr0_cross_fpga_path_count": {"type": "integer", "minimum": 1},
        "sr0_max_tdm_ratio": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
