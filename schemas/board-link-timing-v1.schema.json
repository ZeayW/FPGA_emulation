{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emuflow.dev/schema/board-link-timing-v1.schema.json",
  "title": "EmuFlow directed board-link timing database v1",
  "type": "object",
  "required": [
    "schema",
    "status",
    "platform",
    "measurement_scope",
    "final_link_timing_signoff",
    "links"
  ],
  "properties": {
    "schema": {"const": "emuflow.board-link-timing/v1"},
    "status": {"const": "pass"},
    "platform": {"type": "string", "minLength": 1},
    "measurement_scope": {
      "const": "tx-transport-stage-to-rx-transport-stage"
    },
    "final_link_timing_signoff": {"type": "boolean"},
    "links": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "link",
          "from",
          "to",
          "fabric_clock_mhz",
          "latency_cycles",
          "delay_bound_ns",
          "qualification",
          "source"
        ],
        "properties": {
          "reference_tdm_ratio": {"type": "integer", "minimum": 1},
          "tdm_delay_model": {
            "type": "object",
            "required": ["model", "intercept_ns", "ratio_coefficient_ns", "min_ratio", "max_ratio", "ratio_quantum"],
            "properties": {
              "model": {"const": "linear-ratio-v1"},
              "intercept_ns": {"type": "number", "minimum": 0},
              "ratio_coefficient_ns": {"type": "number", "minimum": 0},
              "min_ratio": {"type": "integer", "minimum": 1},
              "max_ratio": {"type": "integer", "minimum": 1},
              "ratio_quantum": {"type": "integer", "minimum": 1}
            },
            "additionalProperties": false
          },
          "qualification": {
            "enum": [
              "model-only",
              "characterized-upper-bound",
              "measured-upper-bound"
            ]
          }
        }
      }
    }
  }
}
