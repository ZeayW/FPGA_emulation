{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emuflow.dev/schema/platform-calibration-campaign-manifest-v1.schema.json",
  "title": "EmuFlow materialized platform calibration campaign manifest v1",
  "type": "object",
  "required": ["schema", "dataset", "cases", "execution_policy"],
  "properties": {
    "schema": {"const": "emuflow.platform-calibration-campaign-manifest/v1"},
    "dataset": {"type": "object"},
    "cases": {"type": "array", "minItems": 1},
    "execution_policy": {
      "type": "object",
      "required": ["cold_start", "persistent_cache", "raw_reports_retained_in_repository", "infrastructure_failures_are_capacity_failures"],
      "properties": {
        "cold_start": {"const": true},
        "persistent_cache": {"const": false},
        "raw_reports_retained_in_repository": {"const": false},
        "infrastructure_failures_are_capacity_failures": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
