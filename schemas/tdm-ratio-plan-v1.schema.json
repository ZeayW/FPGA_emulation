{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emuflow.dev/schemas/tdm-ratio-plan-v1.schema.json",
  "title": "EmuFlow timing-aware TDM ratio plan",
  "type": "object",
  "required": [
    "schema",
    "design",
    "platform",
    "provider",
    "configuration",
    "normalization",
    "round_barrier_legalization",
    "domains",
    "hops",
    "timing_paths",
    "metrics"
  ],
  "properties": {
    "schema": {
      "const": "emuflow.tdm-ratio-plan/v1"
    },
    "design": {
      "type": ["string", "null"]
    },
    "platform": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "const": "lagrangian-kkt-timing-aware-v1"
    },
    "configuration": {
      "type": "object",
      "required": [
        "max_iterations",
        "max_ratio",
        "ratio_quantum",
        "post_refinement_iterations",
        "convergence"
      ],
      "properties": {
        "max_iterations": {"type": "integer", "minimum": 1},
        "max_ratio": {"type": "integer", "minimum": 1},
        "ratio_quantum": {"type": "integer", "minimum": 1},
        "post_refinement_iterations": {
          "type": "integer",
          "minimum": 0
        },
        "convergence": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    },
    "normalization": {
      "type": "object",
      "required": [
        "positive_slack_scale_ns",
        "negative_slack_scale_ns",
        "max_clock_period_ns"
      ],
      "additionalProperties": {
        "type": "number",
        "exclusiveMinimum": 0
      }
    },
    "round_barrier_legalization": {
      "type": "object",
      "required": [
        "active_rounds",
        "source_ready_slot",
        "promoted_hops",
        "promotion_steps",
        "pre_legalization_worst_normalized_slack",
        "round_aware_lane_rebalanced_hops"
      ]
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "index",
          "key",
          "link",
          "direction",
          "lanes"
        ]
      }
    },
    "hops": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "index",
          "demand",
          "net",
          "transport_round",
          "link",
          "from",
          "to",
          "capacity_key",
          "domain",
          "direction",
          "continuous_ratio",
          "discrete_ratio",
          "lane"
        ]
      }
    },
    "timing_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "index",
          "id",
          "clock_domain",
          "clock_period_ns",
          "required_time_ns",
          "fixed_delay_ns",
          "cut_nets",
          "hops",
          "delay_ns",
          "slack_ns",
          "normalized_slack"
        ]
      }
    },
    "metrics": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
