{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emuflow.dev/schemas/cross-layer-physical-binding-certificate-v1.schema.json",
  "title": "Cross-layer physical coverage certificate",
  "description": "Bounded summary and original typed-source references. Full binding relations are invocation scratch and must be replayed from the original sources for diagnostics.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "header", "sections", "sources", "logical_sha256"],
  "properties": {
    "schema": {"const": "emuflow.cross-layer-physical-binding-certificate/v1"},
    "logical_sha256": {"$ref": "#/$defs/sha256"},
    "header": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "provider", "status", "design", "platform", "transport_semantics", "cross_layer_timing_sha256", "physical_source", "metrics"],
      "properties": {
        "schema": {"const": "emuflow.cross-layer-physical-binding/v1"},
        "provider": {"const": "provider-neutral-routed-physical-evidence-v1"},
        "status": {"enum": ["pass", "incomplete"]},
        "design": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "minLength": 1},
        "transport_semantics": {"enum": ["registered-boundary", "sampled-virtual-wire"]},
        "cross_layer_timing_sha256": {"$ref": "#/$defs/sha256"},
        "physical_source": {
          "type": "object", "additionalProperties": false,
          "required": ["provider", "qualification"],
          "properties": {"provider": {"type": ["string", "null"]}, "qualification": {"type": ["string", "null"]}}
        },
        "metrics": {
          "type": "object", "additionalProperties": false,
          "required": ["required_endpoints", "measured_endpoints", "required_logic_segments", "measured_logic_segments", "routed_board_hops", "model_only_board_hops", "characterized_board_hops", "measured_board_hops", "final_board_link_timing_signoff"],
          "properties": {
            "required_endpoints": {"$ref": "#/$defs/count"}, "measured_endpoints": {"$ref": "#/$defs/count"},
            "required_logic_segments": {"$ref": "#/$defs/count"}, "measured_logic_segments": {"$ref": "#/$defs/count"},
            "routed_board_hops": {"$ref": "#/$defs/count"}, "model_only_board_hops": {"$ref": "#/$defs/count"},
            "characterized_board_hops": {"$ref": "#/$defs/count"}, "measured_board_hops": {"$ref": "#/$defs/count"},
            "final_board_link_timing_signoff": {"type": "boolean"}
          }
        }
      }
    },
    "sections": {
      "type": "object", "additionalProperties": false,
      "required": ["endpoint_bindings", "logic_segment_bindings", "board_bindings", "missing_endpoints", "missing_logic"],
      "properties": {
        "endpoint_bindings": {"$ref": "#/$defs/section"}, "logic_segment_bindings": {"$ref": "#/$defs/section"},
        "board_bindings": {"$ref": "#/$defs/section"}, "missing_endpoints": {"$ref": "#/$defs/section"},
        "missing_logic": {"$ref": "#/$defs/section"}
      }
    },
    "sources": {
      "type": "array", "maxItems": 2048,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["path", "schema", "generation"],
        "properties": {
          "path": {"type": "string", "minLength": 1}, "schema": {"type": "string", "minLength": 1, "maxLength": 256},
          "generation": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"type": "integer"}}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "count": {"type": "integer", "minimum": 0},
    "section": {"type": "object", "additionalProperties": false, "required": ["records", "sha256"], "properties": {"records": {"$ref": "#/$defs/count"}, "sha256": {"$ref": "#/$defs/sha256"}}}
  }
}
